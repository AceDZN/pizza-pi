{
  "name": "pizza-pi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pizza Pi (פיצה π) — a 3D pizzeria rush game for grade-8 circle, percent and ratio math",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5177 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5177 --strictPort",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@fontsource/rubik": "5.2.8",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.2.1",
    "@gltf-transform/extensions": "4.2.1",
    "@types/node": "24.19.2",
    "@types/three": "0.183.1",
    "meshoptimizer": "0.25.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
